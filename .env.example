# ==============================================================================
# AgentForce AI - Environment Configuration (.env.example)
# Source of truth: docs/04_API_KEYS_AND_ENV.md
# Copy this file to .env and configure real credentials. Never commit .env!
# ==============================================================================

# LLM PROVIDERS
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LITELLM_MASTER_KEY=sk-agentforce-litellm-proxy-master-key-placeholder

# Supabase Auth + PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Supabase PostgreSQL or local fallback. Format: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Sync database URL for Alembic migrations if needed (or alembic will use sync driver)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/postgres

# Local infrastructure
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Local file storage (no S3 or MinIO)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Application encryption (only if needed for stored integration credentials)
ENCRYPTION_KEY=

# Mock business services
ERP_BASE_URL=http://localhost:8100
ATS_BASE_URL=http://localhost:8101
HRMS_BASE_URL=http://localhost:8102
CRM_BASE_URL=http://localhost:8103

# Voice AI
STT_PROVIDER=faster_whisper
WHISPER_MODEL=small
TTS_PROVIDER=edge_tts
TTS_VOICE=en-IN-NeerjaNeural

# Observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3001
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Platform
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAX_WORKFLOW_STEPS=30
MAX_TOOL_CALLS_PER_TASK=10
MAX_RETRIES=3
APPROVAL_EXPIRY_HOURS=24

